# ===== 临时目录 =====
logs/
# 根级构建/产物目录用前导 `/` 锚定: 裸 `build/`、`other/` 会连带忽略 src/ 下的
# 同名源码目录 (实测误伤 src/user/vendor/wasmi_ir/build/)
/build/
isodir/
tmp/
/other/
backup/
.mimocode/

# 本地审计临时输出 (历史遗留目录, 非源码)
/src/kernel/other/

# ===== 临时文件扩展 =====
# 通用临时文件 (一些工具链或编辑器会生成)
*.tmp
*.temp

# 日志文件 (构建/运行日志; other/ 下产物由 other/ 全局忽略覆盖)
*.log

# Linux coredump 防御 (内核崩溃可能产生)
# 锚定根目录: 裸 `core` 会吞掉任意层名为 core 的源码目录
# (实测误伤 src/user/vendor/wasmparser/src/{readers,validator}/core)
/core
core.[0-9]*

# ===== 通用构建产物 =====
*.o
*.a
*.so
*.d
*.ko
*.ll

# 链接与二进制产物
*.bin
*.elf
*.iso
*.img
*.map
*.sym
*.lst

# ===== Rust / Cargo 产物 =====
# 使用 globstar 模式覆盖所有 Cargo workspace 子项目
# (历史上漏掉了 miri-tests/target/, 现统一用 **/target/ 防漏)
**/target/
# 别名/临时目标目录 (如 --target-dir target-kt / target_roll 产生的一次性
# 构建目录), 防止构建产物漏出 (CACHEDIR.TAG 不被 git 识别)
**/target-*/
**/target_*/
**/Cargo.lock.bak
*.rs.bk

# 预编译 Rust 库产物 (miri-tests/libverus_targets.rlib 不应入仓)
*.rlib

# Cargo 调试编译数据库 (clangd/rust-analyzer 生成)
compile_commands.json

# ===== C 工具链产物 =====
# gcc/clang 覆盖率
*.gcno
*.gcda
*.gcov

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyz

# Python 虚拟环境 (venv 内部虽有自动生成的 .gitignore, 此处显式兜底)
venv/
.venv/

# Python 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ===== 操作系统垃圾 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 编辑器/IDE 临时文件 =====
*.swp
*.swo
*~
*.bak
*.orig
# cargo vendor 完整性: vendored crate 的 Cargo.toml.orig 被 .cargo-checksum.json
# 收账, 属 vendor 源树的一部分 (通用 *.orig 规则不适用于此)
!src/user/vendor/**/Cargo.toml.orig
*.rej

# IDE 配置目录
.idea/
.vs/
.vscode/
.trae/
*.code-workspace
*.iml

# ===== 本地环境配置 =====
# 严禁上传密钥/凭据
.env
.envrc
.env.*
!.env.example

# ===== 启动盘/调试产物 =====
boot_disk*
*.pcap

# ===== 工具锁文件 =====
# 防止误提交的工具锁文件 (如 miri-tests/gitee..lock)
*..lock

# ===== GDB 临时调试脚本 =====
# 一次性调试脚本 (如 .gdb_debug_gic, .gdb_pt_check)
.gdb_debug_*
.gdb_pt_*

# ===== 构建缓存 =====
# 构建架构缓存文件已迁移至 other/build/log/.arch (受 other/ 全局忽略保护, 无需单独规则)

# ===== D7 L1 fixture 共享对象 =====
# 这是刻意入仓的测试载荷，不是构建产物；`*.so` 通用规则不应吞掉它。
!scripts/fixtures/dynamic-glibc-x86_64/libdlprobe.so
!scripts/fixtures/dynamic-glibc-aarch64/libdlprobe.so
