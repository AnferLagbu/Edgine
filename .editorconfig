# EditorConfig - Edgine Kernel
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C source files
[*.c]
max_line_length = 100

# C header files
[*.h]
max_line_length = 100

# Assembly files
[*.s]
indent_style = tab
indent_size = 8

[*.asm]
indent_style = tab
indent_size = 8

# Rust files
[*.rs]
max_line_length = 100

# Makefiles
[Makefile]
indent_style = tab

# Markdown documentation
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Shell scripts
[*.sh]
indent_style = space
indent_size = 4

# Python scripts
[*.py]
max_line_length = 88

# JSON configuration files
[*.json]
indent_size = 2

# TOML configuration files
[*.toml]
indent_size = 4
